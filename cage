#!/usr/bin/env bash
# cage: each coding agent in its own microVM, reachable from Telegram.
#
# This script is glue. The heavy lifting is done by two existing projects:
#   microsandbox  (https://github.com/superradcompany/microsandbox)  microVM per agent, volumes, egress policy
#   cc-connect    (https://github.com/chenhg5/cc-connect)            chat bot + drivers for the official agent CLIs
# cage renders one cc-connect config per agent and runs each agent + its cc-connect inside its own microVM.
set -euo pipefail

CAGE_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CAGE_HOME="${CAGE_HOME:-$HOME/.cage}"
CAGE_ENV="${CAGE_ENV:-$CAGE_HOME/cage.env}"
MSB="${CAGE_MSB:-msb}"
KINDS="claude codex cursor antigravity"

die() { echo "cage: $*" >&2; exit 1; }
say() { echo "cage: $*" >&2; }

load_env() {
  [ -f "$CAGE_ENV" ] || die "no config at $CAGE_ENV; run \`cage init\` first"
  # shellcheck disable=SC1090
  . "$CAGE_ENV"
  CAGE_AGENTS="${CAGE_AGENTS:-claude codex cursor antigravity}"
  CAGE_CPUS="${CAGE_CPUS:-2}"
  CAGE_MEMORY="${CAGE_MEMORY:-4G}"
  CAGE_ROOT_DISK="${CAGE_ROOT_DISK:-16G}"
  CAGE_MODE="${CAGE_MODE:-yolo}"
  CAGE_IMAGE="${CAGE_IMAGE:-ubuntu:24.04}"
  CAGE_CC_CONNECT_VERSION="${CAGE_CC_CONNECT_VERSION:-v1.5.0}"
  CAGE_TELEGRAM_GROUP_REPLY_ALL="${CAGE_TELEGRAM_GROUP_REPLY_ALL:-false}"
  CAGE_TELEGRAM_ALLOW="${CAGE_TELEGRAM_ALLOW:-}"
}

check_agent() {
  case " $KINDS " in *" $1 "*) ;; *) die "unknown agent \"$1\" (choose from: $KINDS)" ;; esac
}

# Sets AGENTS to the named agents, or to CAGE_AGENTS. Runs in the main shell so `die` really exits.
resolve_agents() {
  if [ $# -gt 0 ]; then AGENTS=("$@"); else read -r -a AGENTS <<<"$CAGE_AGENTS"; fi
  [ "${#AGENTS[@]}" -gt 0 ] || die "no agents given and CAGE_AGENTS is empty"
  for a in "${AGENTS[@]}"; do check_agent "$a"; done
}

vm() { echo "cage-$1"; }

# cc-connect agent type and autonomy mode for each agent. "yolo" is safe because the microVM is the sandbox.
cc_type() { case "$1" in claude) echo claudecode ;; *) echo "$1" ;; esac; }
cc_mode() {
  if [ "$CAGE_MODE" != yolo ]; then echo default; return; fi
  case "$1" in claude) echo bypassPermissions ;; cursor) echo force ;; *) echo yolo ;; esac
}
cc_cmd() { case "$1" in cursor) echo cursor-agent ;; antigravity) echo agy ;; *) echo "" ;; esac; }

login_cmd() {
  case "$1" in
    claude) echo "claude auth login --claudeai" ;;
    codex) echo "codex login --device-auth" ;;
    cursor) echo "NO_OPEN_BROWSER=1 cursor-agent login" ;;
    antigravity) echo "agy" ;;
  esac
}
auth_check_cmd() {
  case "$1" in
    claude) echo "claude auth status >/dev/null 2>&1" ;;
    codex) echo "codex login status >/dev/null 2>&1" ;;
    cursor) echo "cursor-agent status --format json 2>/dev/null | grep -q '\"isAuthenticated\": *true'" ;;
    antigravity) echo "agy models >/dev/null 2>&1" ;;
  esac
}

token_for() {
  local var="CAGE_TELEGRAM_TOKEN_$1"
  echo "${!var:-}"
}

# Writes $CAGE_HOME/agents/<agent>/cc-connect.toml (0600). Values are validated, so no TOML escaping is needed.
render_config() {
  local a="$1" token dir cmd cmdline=""
  token="$(token_for "$a")"
  [[ "$token" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]] || die "CAGE_TELEGRAM_TOKEN_$a is missing or not a bot token (get one from @BotFather)"
  [[ "$CAGE_TELEGRAM_ALLOW" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "CAGE_TELEGRAM_ALLOW must be your numeric Telegram user id(s), comma-separated"
  [[ "$CAGE_TELEGRAM_GROUP_REPLY_ALL" =~ ^(true|false)$ ]] || die "CAGE_TELEGRAM_GROUP_REPLY_ALL must be true or false"
  dir="$CAGE_HOME/agents/$a"
  mkdir -p "$dir"
  chmod 700 "$CAGE_HOME" "$CAGE_HOME/agents" "$dir"
  cmd="$(cc_cmd "$a")"
  [ -n "$cmd" ] && cmdline="cmd = \"$cmd\""
  (
    umask 077
    cat > "$dir/cc-connect.toml" <<EOF
# Generated by cage from $CAGE_ENV. Edit that file and run \`cage up $a\` instead of editing this one.
data_dir = "/home/agent/.cc-connect/data"

[log]
level = "info"

[[projects]]
name = "$a"
admin_from = "$CAGE_TELEGRAM_ALLOW"

[projects.agent]
type = "$(cc_type "$a")"

[projects.agent.options]
work_dir = "/home/agent/work"
mode = "$(cc_mode "$a")"
$cmdline

[[projects.platforms]]
type = "telegram"

[projects.platforms.options]
token = "$token"
allow_from = "$CAGE_TELEGRAM_ALLOW"
group_reply_all = $CAGE_TELEGRAM_GROUP_REPLY_ALL
EOF
  )
}

exists() { "$MSB" inspect "$(vm "$1")" >/dev/null 2>&1; }

wait_provisioned() {
  local a="$1" i=0
  until "$MSB" exec --no-stdin "$(vm "$a")" -- test -e "/opt/cage/provisioned-$a" >/dev/null 2>&1; do
    [ $i -eq 0 ] && say "waiting for $(vm "$a") to finish installing (first boot takes a few minutes; \`cage logs $a\` shows progress)"
    i=$((i + 1))
    [ $i -gt 180 ] && die "$(vm "$a") is still not provisioned after 15 minutes; check \`cage logs $a\`"
    sleep 5
  done
}

agent_exec() { # agent_exec <agent> <tty:yes|no> <command>
  local tty=--no-tty
  [ "$2" = yes ] && tty=-t
  "$MSB" exec "$tty" -u agent -e HOME=/home/agent -w /home/agent "$(vm "$1")" -- \
    bash -lc "set -a; [ -r /etc/cage/env ] && . /etc/cage/env; set +a; $3"
}

cmd_init() {
  mkdir -p "$CAGE_HOME" && chmod 700 "$CAGE_HOME"
  if [ -f "$CAGE_ENV" ]; then say "$CAGE_ENV already exists; leaving it alone"; exit 0; fi
  (umask 077; cp "$CAGE_ROOT/cage.env.example" "$CAGE_ENV")
  say "wrote $CAGE_ENV. Fill in your Telegram user id and one bot token per agent, then: cage doctor && cage up"
}

cmd_doctor() {
  local ok=1
  command -v "$MSB" >/dev/null || { echo "✗ microsandbox CLI not found: curl -fsSL https://install.microsandbox.dev | sh  (macOS: brew install superradcompany/tap/microsandbox)"; ok=0; }
  case "$(uname -s)/$(uname -m)" in
    Darwin/arm64) echo "✓ macOS on Apple Silicon" ;;
    Darwin/*) echo "✗ microsandbox needs Apple Silicon on macOS"; ok=0 ;;
    Linux/*) if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then echo "✓ /dev/kvm accessible"; else echo "✗ /dev/kvm not accessible (enable virtualization; sudo usermod -aG kvm \$USER)"; ok=0; fi ;;
  esac
  if [ -f "$CAGE_ENV" ]; then
    load_env
    echo "✓ config $CAGE_ENV (agents: $CAGE_AGENTS)"
    [[ "$CAGE_TELEGRAM_ALLOW" =~ ^[0-9]+(,[0-9]+)*$ ]] && echo "✓ Telegram allowlist: $CAGE_TELEGRAM_ALLOW" || { echo "✗ CAGE_TELEGRAM_ALLOW is not set to numeric user id(s)"; ok=0; }
    for a in $CAGE_AGENTS; do
      [[ "$(token_for "$a")" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]] && echo "✓ bot token for $a" || { echo "✗ CAGE_TELEGRAM_TOKEN_$a missing"; ok=0; }
    done
  else
    echo "✗ no config at $CAGE_ENV (cage init)"; ok=0
  fi
  [ $ok = 1 ] || exit 1
}

cmd_up() {
  load_env
  resolve_agents "$@"
  for a in "${AGENTS[@]}"; do
    render_config "$a"
    if exists "$a"; then
      say "restarting $(vm "$a") with fresh config"
      "$MSB" restart "$(vm "$a")"
    else
      say "creating $(vm "$a") ($CAGE_CPUS vCPU, $CAGE_MEMORY RAM, $CAGE_ROOT_DISK disk, image $CAGE_IMAGE)"
      # Default microsandbox network policy: public internet only; host, LAN, loopback and cloud metadata blocked.
      # shellcheck disable=SC2086
      "$MSB" run -d --name "$(vm "$a")" --label app=cage --label "cage.agent=$a" \
        -c "$CAGE_CPUS" -m "$CAGE_MEMORY" --root-disk "$CAGE_ROOT_DISK" \
        --mount-named "$(vm "$a")-home:/home/agent" \
        --mount-dir "$CAGE_ROOT/guest:/cage:ro" \
        --mount-dir "$CAGE_HOME/agents/$a:/cage-config:ro" \
        -e "CC_CONNECT_VERSION=$CAGE_CC_CONNECT_VERSION" \
        ${CAGE_MSB_EXTRA_ARGS:-} \
        "$CAGE_IMAGE" -- /bin/bash /cage/entry.sh "$a"
    fi
  done
  say "VMs are installing in the background. Next: cage login <agent>  (cage logs <agent> shows progress)"
}

cmd_login() {
  load_env
  local a="${1:-}"
  [ -n "$a" ] || die "usage: cage login <agent>"
  check_agent "$a"
  exists "$a" || die "$(vm "$a") does not exist; run \`cage up $a\`"
  wait_provisioned "$a"
  case "$a" in
    claude) say "Open the URL, sign in with your Claude Pro/Max account, paste the code back." ;;
    codex) say "Device code sign-in. First enable device-code login for Codex in ChatGPT → Settings → Security." ;;
    cursor) say "Open the URL on any device and approve; the CLI finishes on its own." ;;
    antigravity) say "Antigravity signs in on first launch: open the URL, use your Google AI Pro/Ultra account, then /quit (or Ctrl-C) once you reach the prompt." ;;
  esac
  agent_exec "$a" yes "$(login_cmd "$a")" || true
  if agent_exec "$a" no "$(auth_check_cmd "$a")"; then say "✓ $a is logged in"; else die "$a still reports not logged in"; fi
}

cmd_status() {
  load_env
  "$MSB" ps -a --label app=cage || true
  for a in $CAGE_AGENTS; do
    if ! exists "$a"; then printf '%-12s %s\n' "$a" "no VM (cage up $a)"; continue; fi
    if agent_exec "$a" no "$(auth_check_cmd "$a")" 2>/dev/null; then printf '%-12s %s\n' "$a" "logged in"; else printf '%-12s %s\n' "$a" "NOT logged in (cage login $a)"; fi
  done
}

cmd_logs() { [ -n "${1:-}" ] || die "usage: cage logs <agent>"; check_agent "$1"; exec "$MSB" logs -f "$(vm "$1")"; }
cmd_shell() { [ -n "${1:-}" ] || die "usage: cage shell <agent>"; check_agent "$1"; agent_exec "$1" yes "cd ~/work 2>/dev/null; exec bash -l"; }

cmd_update() {
  load_env
  resolve_agents "$@"
  for a in "${AGENTS[@]}"; do
    say "updating $a CLI and cc-connect inside $(vm "$a")"
    "$MSB" exec --no-stdin -e "CC_CONNECT_VERSION=$CAGE_CC_CONNECT_VERSION" "$(vm "$a")" -- bash /cage/provision.sh "$a" --update
    "$MSB" restart "$(vm "$a")"
  done
}

cmd_down() {
  load_env
  resolve_agents "$@"
  for a in "${AGENTS[@]}"; do "$MSB" stop "$(vm "$a")" || true; done
}

cmd_destroy() {
  local a="${1:-}" flag="${2:-}"
  [ -n "$a" ] || die "usage: cage destroy <agent> [--keep-login|--yes]"
  check_agent "$a"
  case "$flag" in
    --keep-login) "$MSB" rm --force "$(vm "$a")"; say "removed $(vm "$a"); its home volume (login, work) was kept" ;;
    --yes) "$MSB" rm --force "$(vm "$a")"; "$MSB" volume rm "$(vm "$a")-home"; say "removed $(vm "$a") and its home volume" ;;
    *) die "this deletes $(vm "$a"). Add --keep-login to keep its login and files, or --yes to delete everything" ;;
  esac
}

usage() {
  cat <<EOF
cage: Claude Code, Codex, Cursor and Antigravity on your own subscriptions,
each in its own microVM (microsandbox), each reachable as a Telegram bot (cc-connect).

  cage init                       write $CAGE_ENV from the example
  cage doctor                     check host prerequisites and config
  cage up [agent...]              create/start VMs (re-run after editing config)
  cage login <agent>              sign in inside that agent's VM
  cage status                     VMs and login state
  cage logs <agent>               follow the VM's output (provisioning, cc-connect)
  cage shell <agent>              shell inside the VM as the agent user
  cage update [agent...]          reinstall the latest agent CLI + pinned cc-connect
  cage down [agent...]            stop VMs
  cage destroy <agent> --keep-login|--yes

Agents: $KINDS
EOF
}

main() {
  local c="${1:-help}"
  shift || true
  case "$c" in
    init) cmd_init ;;
    doctor) cmd_doctor ;;
    up) cmd_up "$@" ;;
    login) cmd_login "$@" ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    shell) cmd_shell "$@" ;;
    update) cmd_update "$@" ;;
    down) cmd_down "$@" ;;
    destroy) cmd_destroy "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
