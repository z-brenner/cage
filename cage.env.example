# cage configuration. `./cage` copies this to ~/.cage/cage.env (mode 0600) and fills in the Telegram values
# for you as it walks you through setup. It is sourced by bash.

# Agents to run. Each gets its own microVM; you talk to it in cage's app, and in a chat app if you like (a Telegram
# bot each, Slack, Discord). `cage add claude cursor` and `cage setup claude cursor` set this to the agents you name
# (plus any set up earlier).
# claude = Claude Code (Pro/Max login) · codex = Codex (Sign in with ChatGPT)
# cursor = Cursor Agent (Cursor account) · antigravity = Antigravity CLI (Google AI Pro/Ultra;
# it replaced Gemini CLI for subscribers on 2026-06-18)
CAGE_AGENTS="claude codex cursor antigravity"

# Your numeric Telegram user id(s), comma-separated. Only these accounts can talk to the bots.
# Find yours by messaging @userinfobot.
CAGE_TELEGRAM_ALLOW=""

# One bot per agent: @BotFather → /newbot, e.g. "Dot Claude" (@dot_claude_bot). Paste each token.
CAGE_TELEGRAM_TOKEN_claude=""
CAGE_TELEGRAM_TOKEN_codex=""
CAGE_TELEGRAM_TOKEN_cursor=""
CAGE_TELEGRAM_TOKEN_antigravity=""

# In a group with several of your bots: false = a bot answers only when @mentioned (mention several
# bots in one message to fan out); true = every bot answers every message (a group that always asks all).
CAGE_TELEGRAM_GROUP_REPLY_ALL=false

# Autonomy inside the VM: yolo = agents run tools without asking (the microVM is the sandbox);
# ask = cc-connect asks you in the chat before each tool call.
CAGE_MODE=yolo

# Per-VM resources.
CAGE_CPUS=2
CAGE_MEMORY=4G
CAGE_ROOT_DISK=16G   # system disk (CLIs, packages); your login and work live on a separate volume

# The cc-connect release installed in each VM. Set it only to override the version this cage release is tested
# with (then run `cage update`); left unset, each cage update brings the version it's tested with. This cage's is a
# preview (1.5.1-beta.3); if your chats misbehave with it, set "stable" here (the newest stable release this cage
# keeps checksums for, 1.5.0) and run `cage update`. A plain v1.5.0 doesn't do it: earlier cages wrote that very line
# into this file, so cage reads it as theirs and uses its own.
# CAGE_CC_CONNECT_VERSION=

# Ubuntu's packages from a mirror of your own (your company's, or one nearby), like
# "http://mirror.example.com/ubuntu/". Each VM tries it first and falls back to Ubuntu's own servers; security updates
# still come from Ubuntu. Then run `cage up` (with `cage network strict`, also `cage allow` the mirror's host).
# CAGE_APT_MIRROR=

# Extra `msb run` flags for every VM, e.g. an egress allowlist:
#   CAGE_MSB_EXTRA_ARGS="--net-rule …"   (see https://docs.microsandbox.dev/networking/overview.md)
CAGE_MSB_EXTRA_ARGS=""
